# Required Sanity Content Lake connection values. Use a sandbox dataset during development.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_WRITE_TOKEN=

# Required. ANTHROPIC_API_KEY is required by AnthropicProvider's own adapter tests and smoke
# checks even when no tier's ModelSpec currently resolves to Anthropic (src/config/models.ts).
# OPENAI_API_KEY is required by the default OpenAI model mapping in src/config/models.ts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Only required if a tier's ModelSpec (src/config/models.ts) is reconfigured to
# resolve to that provider — providerFactory/imageProviderFactory raise a FatalError at
# resolution time if the corresponding key below is absent when actually needed.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LOCAL_LLM_ENDPOINT_URL=
