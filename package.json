{
  "name": "blogspage-automations",
  "version": "0.1.0",
  "private": true,
  "description": "Blogspage's modular AI content automation pipeline.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src vitest.config.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "pipeline": "node --import=tsx src/cli/runPipeline.ts",
    "resume": "node --import=tsx src/cli/resumePipeline.ts",
    "runs": "node --import=tsx src/cli/listRuns.ts",
    "validate": "node --import=tsx src/cli/validateConfig.ts",
    "attach-images": "node --import=tsx src/cli/attachImages.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.34",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.64.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.112.3",
    "@google/genai": "2.12.0",
    "@sanity/client": "7.8.0",
    "dotenv": "^17.4.2",
    "googleapis": "150.0.1",
    "openai": "6.48.0",
    "zod": "4.4.3"
  }
}
